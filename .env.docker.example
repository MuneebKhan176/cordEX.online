# Merge these values into the repository-root .env on the VPS.
# Keep all existing application secrets and other required settings.

# MySQL application database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=NodeJS_Exchange
DB_USERNAME=cordex_app
DB_PASSWORD=REPLACE_WITH_STRONG_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_MYSQL_ROOT_PASSWORD
MYSQL_ROOT_USER=root

# AI analytics: reader receives SELECT on four AI views only.
AI_DB_HOST=mysql
AI_DB_PORT=3306
AI_DB_NAME=NodeJS_Exchange
AI_DB_USER=cordex_ai_reader
AI_DB_PASSWORD=REPLACE_WITH_STRONG_AI_READER_PASSWORD
AI_INTERNAL_SERVICE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# MongoDB
MONGO_ROOT_USERNAME=cordex_mongo_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MONGO_ROOT_PASSWORD
MONGO_DB_NAME=cordex_social
MONGO_APP_USERNAME=cordex_social_app
MONGO_APP_PASSWORD=REPLACE_WITH_STRONG_MONGO_APP_PASSWORD

# URL-encode credentials if the password contains URI-reserved characters.
MONGO_URI=mongodb://cordex_social_app:REPLACE_WITH_STRONG_MONGO_APP_PASSWORD@mongodb:27017/cordex_social?authSource=cordex_social

# Existing CORDEX application settings (retain your current values).
JWT_SECRET_KEY=
GEMINI_API_KEY=
